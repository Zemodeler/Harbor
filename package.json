{
  "name": "harbor",
  "productName": "Harbor",
  "version": "0.1.0",
  "description": "Project-first desktop app that routes work to installed AI CLIs",
  "main": "./out/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "eval": "tsx scripts/eval/index.ts",
    "headless": "tsx src/main/headlessMain.ts",
    "harbor": "tsx scripts/harbor.ts",
    "dist": "node build/dist.mjs",
    "dist:watch": "node scripts/dist-watch.mjs",
    "dev:renderer": "npm --prefix src/renderer run dev:renderer",
    "test:renderer": "npm --prefix src/renderer test"
  },
  "dependencies": {
    "electron-updater": "6.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
}
